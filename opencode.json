{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gh pr merge*": "deny",
      "gh * pr merge*": "deny",
      "gh api *pulls/*/merge*": "deny",
      "gh api *mergePullRequest*": "deny",
      "gh api *enablePullRequestAutoMerge*": "deny"
    }
  },
  "mcp": {
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "cwm-roslyn-navigator": {
      "type": "local",
      "command": ["cwm-roslyn-navigator"],
      "enabled": true
    }
  }
}
