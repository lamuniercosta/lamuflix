@model PagedListing<FilmesListViewModel>
@{
    ViewData["Title"] = "Filmes";
    FilmesFilterViewModel? filter = ViewData["CurrentFilter"] as FilmesFilterViewModel;
}
<h2>@Html.DisplayFor(model => model.TotalItems) Filmes Encontrados <a asp-action="CriarFilme" title="Criar Filme"><i class="fa fa-plus-circle"></i></a></h2>


<div class="row">
    <div class="col-md-12" id="filter">
        <form>
            @Html.Hidden("parms.SortBy", ViewData["CurrentSort"])
            @Html.Hidden("parms.SortOrder", ViewData["CurrentSortOrder"])
            <div class="col-md-6">
                <div class="input-group" id="inputTitle">
                    <input type="text" class="field" value="@filter?.SearchField" id="SearchField" name="SearchField" placeholder="Título">
                    <span class="input-group-btn">
                        <button class="btn btn-primary btn-lg" onclick="OpenKeyboard()" type="button" style="height: 44.95px"><span class="fa fa-keyboard-o"></span></button>
                    </span>
                </div>
                <br />
                <div class="form-group">
                    <select name="GenreIds" id="GenreIds" multiple value="filter.GenreIds" asp-items="@ViewBag.GenreIds" class="form-control" data-val="true"></select>
                </div>
                <div class="form-group">
                    <select name="ActorIds" id="ActorIds" multiple value="filter.ActorIds" asp-items="@ViewBag.ActorIds" class="form-control" data-val="true"></select>
                </div>

            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.DropDownList("Year", null, "Ano", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.DropDownList("DirectorId", null, "Diretor", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.DropDownList("CollectionId", null, "Coleção", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button class="btn btn-success" type="submit">Go!</button>
                    @Html.ActionLink("Limpar", "Index", "Filmes", null, new { @class = "btn btn-default", @style = "background-color: buttonface" })
                </div>
            </div>
        </form>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th style="width: 30px;"></th>
                    <th>
                        <a href="#/" onclick="SortList('Title','@ViewData["SortOrder"]')">@Html.DisplayName("Título")</a>
                    </th>
                    <th>
                        <a href="#/" onclick="SortList('Year','@ViewData["SortOrder"]')">@Html.DisplayName("Ano")</a>
                    </th>
                    <th>
                        <a href="#/" onclick="SortList('Duration','@ViewData["SortOrder"]')">@Html.DisplayName("Duração")</a>
                    </th>
                    <th>
                        <a href="#/" onclick="SortList('ImdbRating','@ViewData["SortOrder"]')"> @Html.DisplayName("Nota IMDb")</a>
                    </th>
                    <th>
                        <a href="#/" onclick="SortList('MetaScore','@ViewData["SortOrder"]')"> @Html.DisplayName("MetaScore")</a>
                    </th>
                    <th>
                        <a href="#/" onclick="SortList('RottenTomatoes','@ViewData["SortOrder"]')"> @Html.DisplayName("Rotten Tomatoes")</a>
                    </th>
                    <th style="width: 30px;"></th>
                    <th style="width: 30px;"></th>
                    <th style="width: 30px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                <tr>
                    <td>
                        <a href="@Url.Action("Details", new { id = item.Id })">
                            <img style="width:100px; height:150px" title="Ver detalhes" src="@item.Poster">
                        </a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Year)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Duration) min
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IMDB)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MetaScore)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RottenTomatoes)%
                    </td>
                    <td>
                        <a href="#/" title="Assistir Filme" onclick="AssistirFilme('@item.Id')"><i class="fa fa-play-circle-o fa-3x"></i></a>
                    </td>
                    <td>
                        <a href="#/" title="Excluir Filme" onclick="ExcluirFilme('@item.Id')"><i style="color: red" class="fa fa-trash-o fa-3x"></i></a>
                    </td>
                    <td>
                        <a href="#/" title="@item.WatchListTitle" onclick="@item.WatchListMethod"><i style="color: forestgreen" class="@item.WatchListIcon"></i></a>
                    </td>
                </tr>}
            </tbody>
        </table>

        <pagination asp-paginationlist="@Model"></pagination>
    </div>
</div>