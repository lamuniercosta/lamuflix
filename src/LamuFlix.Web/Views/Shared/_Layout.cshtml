<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LamuFlix</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.css" />
    <link href="~/lib/jquery-ui-1.12.1/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/fastselect-master/dist/fastselect.css">
    <link href="~/lib/Keyboard-master/css/keyboard.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">

                <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <img style="height:50px; " src="~/images/lamuflix-LOGO.png" />
                </a>
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                </button>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li><a asp-area="" asp-controller="Movies" asp-action="Index">Filmes</a></li>
                    <li><a asp-area="" asp-controller="Movies" asp-action="Watchlist">Minha Lista</a></li>
                </ul>
                <div style="float:right; margin-top:15px; margin-right:-5%" class="col-sm-3 col-md-3">
                    <form class="navbar-form" role="search">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Busca Rápida" id="QuickSearchField">
                            <div class="input-group-btn">
                                <button class="btn btn-default" type="button" id="QuickSearchButton"><i class="glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </nav>

    <partial name="_CookieConsentPartial" />

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2018 - LamuFlix.Web</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-ui-1.12.1/jquery-ui.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/lib/fastselect-master/dist/fastselect.standalone.js"></script>
    <script src="~/lib/Keyboard-master/js/jquery.keyboard.js"></script>
    <script src="~/lib/Keyboard-master/js/jquery.keyboard.extension-autocomplete.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    @RenderSection("Scripts", required: false)
</body>
</html>
