@model ImportMovieFolderViewModel
@{
    ViewData["Title"] = "Criar Filme";
    AlertModel alertModel = ViewBag.Alerts;
}

<h2>Criar Filme</h2>

@if (alertModel != null)
{
    <alerthelper type="@alertModel.Type" message="@alertModel.Text"></alerthelper>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="ImportMovieFolder">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label asp-for="Movie" class="control-label">Filme</label>
                <input asp-for="Movie" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="CollectionName" class="control-label">Coleção</label>
                <input asp-for="CollectionName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="MovieId" class="control-label">ID</label>
                <input asp-for="MovieId" class="form-control" />
            </div>
            <div class="form-group">
                <button class="btn btn-success" type="submit">Salvar</button>
                @Html.ActionLink("Cancelar", "Index", "Movies", null, new { @class = "btn btn-default", @style = "background-color: buttonface" })
            </div>
        </form>
    </div>
</div>
