# Copy this file to `.env` and replace every placeholder below with local supplied values.
# Do not commit the resulting `.env`; it is ignored by .gitignore.
POSTGRES_USER=change
POSTGRES_PASSWORD=change
RABBITMQ_USER=change
RABBITMQ_PASSWORD=change
# Optional (uncomment and replace): LIBRARY_PATH=/path/to/library

# Ollama provisioning (non-secret development settings).
# The pinned image digest is shared by both Ollama compose services and the
# opt-in OllamaIntegration test; keep all of them in sync when upgrading.
OLLAMA_IMAGE=ollama/ollama:0.40.8@sha256:2b8eecdb85aa6ea67c381c8ecffec04b2658496cf2821a8f88b0485bdff198e8
# Embedding model pulled by ollama-model-init. Must produce 384-dimensional vectors.
OLLAMA_EMBEDDING_MODEL=all-minilm
# Initializer budgets in whole seconds: server readiness, model pull, and poll interval.
OLLAMA_READY_TIMEOUT_SECONDS=120
OLLAMA_PULL_TIMEOUT_SECONDS=900
OLLAMA_POLL_INTERVAL_SECONDS=2
