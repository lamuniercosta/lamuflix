    "/api/movies": {
      "get": {
        "tags": [
          "LibraryEndpoints"
        ],
        "summary": "Browse movies using the canonical library query string keys.",
        "operationId": "BrowseMovies",
        "parameters": [
          {
            "name": "Text",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "GenreIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ActorIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "RuntimeMin",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RuntimeMax",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RuntimeIncludeUnknown",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "YearMin",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "YearMax",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Statuses",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "InWatchlist",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "Title",
                "Year",
                "Rating",
                "Runtime"
              ],
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "Ascending",
                "Descending"
              ],
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseMoviesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
