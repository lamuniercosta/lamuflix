{
  "note": "Names only. New-HomeCluster.ps1 builds each Secret from files in the ops secrets folder. No values belong in Git.",
  "secrets": [
    {
      "name": "catalog-database",
      "keys": ["DATABASE_URL"],
      "optional": false
    },
    {
      "name": "rabbitmq-credentials",
      "keys": ["RABBITMQ_DEFAULT_USER", "RABBITMQ_DEFAULT_PASS"],
      "optional": false
    },
    {
      "name": "api-settings",
      "keys": ["appsettings.Production.json"],
      "optional": false
    },
    {
      "name": "tmdb-credentials",
      "keys": ["apiKey"],
      "optional": true
    }
  ]
}
