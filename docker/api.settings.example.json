{
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://aspire-dashboard:18889",
  "Features": {
    "LocalPlay": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=lamuflix;Username=change;Password=change"
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "UserName": "change",
    "Password": "change",
    "RetryDelay": "00:00:30"
  },
  "Omdb": {
    "ApiKey": "change"
  },
  "Tmdb": {
    "Enabled": true,
    "ApiKey": "",
    "BaseUrl": "https://api.themoviedb.org/3/"
  },
  "Enrichment": {
    "SweepInterval": "00:01:00",
    "ClaimLease": "00:00:10"
  },
  "Library": {
    "RootPath": "/media/library",
    "LegacyRootPaths": []
  },
  "Subtitles": {
    "SaveEnabled": false,
    "PreferredLanguages": [],
    "OpenSubtitles": {
      "ApiKey": "",
      "BaseUrl": "https://api.opensubtitles.com",
      "UserAgent": "LamuFlix v1.0",
      "DownloadAllowedHosts": ["api.opensubtitles.com", "www.opensubtitles.com"],
      "MaxDownloadBytes": 1048576,
      "RequestTimeout": "00:00:15"
    }
  },
  "StreamConversion": {
    "MaxConcurrentConversions": 2,
    "IdleExpiry": "01:00:00",
    "ScratchSizeLimitBytes": 21474836480,
    "ScratchDirectory": "cache/stream-conversion"
  },
  "Recommendations": {
    "MinimumSimilarity": 0.225,
    "CrowdEnabled": false,
    "StrongReasonCriteria": ["Collection", "Director", "Themes"]
  }
}
